# Optional: base path when the static site is served from a sub-path (e.g. GitHub Pages).
# Leave empty for Vercel / root deployments. Used to locate the offline OCR assets.
NEXT_PUBLIC_BASE_PATH=

# Server-only: enables "Thiết kế bằng AI" (/api/ai-layout). Set in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5).
AI_LAYOUT_MODEL=
